import sqlite3

DB_FILE = "network_traffic.db"

def print_all_entries():
    """
    Connects to the SQLite database and prints all logged traffic entries
    in a clean, readable table format.
    """
    try:
        conn = sqlite3.connect(DB_FILE)
        cursor = conn.cursor()
        
        # Select the most important columns to display in the terminal
        cursor.execute("SELECT id, domain, timestamp, city, country, isp FROM geo_traffic")
        rows = cursor.fetchall()
        
        if not rows:
            print("\n[*] The database is currently empty.")
            conn.close()
            return

        print("\n" + "=" * 115)
        # Define column headers with alignment spacing
        # <5 means left-aligned 5 spaces, <25 means left-aligned 25 spaces, etc.
        header_format = "{:<5} | {:<25} | {:<20} | {:<15} | {:<15} | {:<20}"
        print(header_format.format("ID", "Domain", "Timestamp", "City", "Country", "ISP"))
        print("=" * 115)
        
        # Print each row safely, converting None values to 'N/A' strings
        for row in rows:
            print(header_format.format(
                row[0],
                str(row[1]),
                str(row[2]),
                str(row[3]) if row[3] else "N/A",
                str(row[4]) if row[4] else "N/A",
                str(row[5]) if row[5] else "N/A"
            ))
            
        print("=" * 115)
        print(f"[*] Total entries found: {len(rows)}\n")

    except sqlite3.Error as e:
        print(f"[!] Failed to read database: {e}")
    finally:
        conn.close()


print_all_entries()